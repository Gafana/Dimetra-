# Copy to .env.local (gitignored). Used only on your machine — never set on Render/Vercel.

# Enable local browser UI without Telegram Mini App
LOCAL_DEV=true

# Isolated test user in Neon (separate from your real Telegram account)
LOCAL_DEV_CHAT_ID=900001

# Optional: keep PORT aligned with frontend (default in this repo is often 3001)
# PORT=3001

# DATABASE_URL from: neon env pull

# Omit BOT_TOKEN here to avoid long-polling conflict with production Render bot.
# Or leave BOT_TOKEN unset in .env.local so production token in .env is overridden empty — use HTTP API only locally.
