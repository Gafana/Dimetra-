BOT_TOKEN=your_telegram_bot_token
WEB_APP_URL=https://your-app.vercel.app
PORT=3000
TZ=Europe/Moscow

# Promo codes. Pepper is the HMAC secret (min 16 chars). Never commit a real value.
# PROMO_CODE_PEPPER=
# Comma-separated Telegram user IDs allowed to run /promo
# PROMO_ADMIN_IDS=

# Optional: override public URL for self-ping (otherwise RENDER_EXTERNAL_URL on Render)
# KEEPALIVE_URL=https://your-service.onrender.com

# Disable self-ping and Telegram bot when developing locally
# LOCAL_DEV=true

# Neon (Frankfurt): after `neon link` run `neon env pull` — writes DATABASE_URL here or to .env.local
# Use pooled DATABASE_URL for Express (not UNPOOLED).
# DATABASE_URL=postgresql://...@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
