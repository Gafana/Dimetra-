{
  "name": "dimetra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-backend.ps1",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:all": "concurrently -n backend,frontend -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "tunnels": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-tunnels.ps1",
    "neon:agent-setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/neon-agent-setup.ps1",
    "build": "tsc",
    "build:frontend": "npm run build --prefix frontend",
    "build:all": "npm run build && npm run build:frontend",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "db:init": "tsx scripts/db-init.ts",
    "catalog:scrape": "tsx scripts/scrape-floralworld-catalog.ts",
    "catalog:scrape:sample": "tsx scripts/scrape-floralworld-catalog.ts --limit 40",
    "catalog:sync-db": "tsx scripts/sync-plant-catalog-to-db.ts",
    "catalog:import": "tsx scripts/scrape-floralworld-catalog.ts && tsx scripts/sync-plant-catalog-to-db.ts --update",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "node-cron": "^4.6.0",
    "pg": "^8.14.1",
    "telegraf": "^4.16.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "cheerio": "^1.0.0",
    "concurrently": "^9.1.2",
    "localtunnel": "^2.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
